
#include <stdio.h>

int main()
{
	int n;
	printf("Enter the array size:");
	scanf("%d",&n);
	int arr[n];
	printf("Enter the array elements:");
	for(int i=0; i<n; i++)
	{
		scanf("%d",&arr[i]);
	}
	int key,index=-1;
	printf("Enter the target:");
	scanf("%d",&key);

	for(int i=0; i<n; i++)
	{
		if(arr[i]==key)
		{
			index=i;
		}
	}
	
	if(index != -1)
	{
	    printf("Element %d found at index %d", key, index);
	}
	else
	{
	    printf("Element %d not found", key);
	}

	return 0;
}
